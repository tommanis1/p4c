mkv1dirs: cmake_check_build_system
	$(MAKE) $(MAKESILENT) -f CMakeFiles/Makefile2 mkv1dirs
.PHONY : mkv1dirs

# fast build rule for target.
mkv1dirs/fast:
	$(MAKE) $(MAKESILENT) -f frontends/CMakeFiles/mkv1dirs.dir/build.make frontends/CMakeFiles/mkv1dirs.dir/build
.PHONY : mkv1dirs/fast

